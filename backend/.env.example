PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pulse
JWT_SECRET=change-me-in-production-use-long-random-string
INVITE_TOKEN_SECRET=change-me-too-separate-from-jwt-if-possible
JWT_EXPIRES_IN=7d
STORAGE_PATH=./storage
FRONTEND_ORIGIN=http://localhost:5173
# Optional app surface selector when deploying split servers:
# APP_SURFACE=crm   # CRM-facing server
# APP_SURFACE=pulse # Pulse-facing server
# APP_SURFACE=all   # default monolith behavior
# Optional platform API requests allowed per 15 minutes (default 300)
# PLATFORM_RATE_LIMIT_MAX=300
# Cross-domain URLs for CRM/Pulse split flows:
# CRM_APP_URL=https://crm.example.com
# PULSE_APP_URL=https://pulse.example.com
# Optional short-lived handoff token TTL (milliseconds), default 120000, max 600000
# PULSE_HANDOFF_TTL_MS=120000
# Data retention policy controls (days)
# EXPORT_RETENTION_DAYS=30
# TOKEN_RETENTION_DAYS=30
# How long a Rhythm Engine survey link stays redeemable after it is sent.
# Re-sending an invite mints a new token and restarts the window.
# Default 90 days, capped at 365.
# PULSE_LINK_TOKEN_TTL_DAYS=90
# RETENTION_PROJECT_CLOSE_DAYS=90
# RETENTION_DRY_RUN=false
# RETENTION_ALERT_WEBHOOK=https://hooks.slack.com/services/...
# RETENTION_ALERT_EMAIL=ops@example.com,security@example.com
# Render Cron cannot mount disks; cron calls POST /api/internal/privacy-maintenance on a web instance.
# PRIVACY_MAINTENANCE_SECRET= # min 24 chars (openssl rand -hex 16); Bearer token for that route
# On the Cron service only — must be the CRM host when CRM mounts the only persistent export disk:
# PRIVACY_MAINTENANCE_URL=https://crm.example.com/api/internal/privacy-maintenance
# CLIENT_DASHBOARD_TOKEN_MAX_HOURS=24
# MFA_ENFORCE_ADMIN=true
# TIER3_DISPOSAL_YEARS=7
# Pulse invite / welcome / reset emails embed the Outlier logo as an inline attachment (CID) when
# frontend/dist/brand/outlier-logo.png or frontend/public/brand/outlier-logo.png exists (normal deploy).
# If neither file exists, set a public absolute URL:
# APP_URL=https://your-app.example.com
# PULSE_EMAIL_LOGO_URL=https://your-cdn.example.com/outlier-logo.png
# Required for sending Pulse links (and password reset): https://resend.com
# RESEND_API_KEY=re_...
# Required for Pulse dashboard "so what" insight (AI-only, no fallback).
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_SUMMARY_MODEL=claude-sonnet-4-20250514
# CLAUDE_SUMMARY_TIMEOUT_MS=2500
# CLAUDE_SUMMARY_MAX_RETRIES=2
# CLAUDE_SUMMARY_RETRY_BASE_DELAY_MS=250
# From address for all Resend emails (verified domain in Resend)
# RESEND_FROM_EMAIL=noreply@your-verified-domain.com
# RESEND_FROM_NAME=Employee Pulse
# Optional legacy single-line "from" if you prefer not to split name/email:
# EMAIL_FROM=Employee Pulse <noreply@your-verified-domain.com>
# JWT_ISSUER=pulse-api
# JWT_AUDIENCE=pulse-web
# DATABASE_SSL=true
# DATABASE_CA_CERT_PATH=/path/to/server-ca.pem
# DATABASE_SSL_ALLOW_SELF_SIGNED=false
# On Render, self-signed certs are allowed by default unless this is explicitly set.
# ENFORCE_HTTPS=true
# Optional overrides for first deploy seed (defaults match project seed)
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=required to create admin during production seed
