K6_BASE_URL="https://your-backend-service.onrender.com"
K6_AUTH_BEARER="replace-with-bearer-token"
# Recommended client-org dashboard path:
# /api/platform/organizations/<org-id>/pulse-dashboard?timepoint=pre
K6_DASHBOARD_PATH="/api/platform/organizations/replace-with-org-id/pulse-dashboard?timepoint=pre"
K6_SLUG_PATH="/api/pulse-link/themes?token=replace-with-pulse-link-token"
K6_SURVEY_SUBMIT_PATH="/api/pulse-link/response/complete?token=replace-with-pulse-link-token"
K6_FRESHNESS_KEY="completedTotal"
K6_MAX_WAIT_SECONDS="90"
K6_TARGET_WINDOW_SECONDS="60"
K6_FRESHNESS_POLL_INTERVAL_SECONDS="5"
# Set false when reusing a previously-completed token in Render smoke tests.
# Set true with a fresh token to enforce strict increment checks.
K6_FRESHNESS_REQUIRE_INCREASE="false"

# Allow 429 as expected response for controlled stress tests behind platform rate limits.
# Keep false for strict pass/fail quality gates.
K6_ALLOW_429="true"

# Render-safe baseline profile defaults (override as needed)
K6_DASHBOARD_VUS="3"
K6_DASHBOARD_DURATION="20s"
K6_DASHBOARD_P95_MS="2000"
K6_DASHBOARD_MAX_FAIL_RATE="0.001"

K6_SLUG_RATE="3"
K6_SLUG_DURATION="60s"
K6_SLUG_PREALLOCATED_VUS="5"
K6_SLUG_MAX_VUS="30"
K6_SLUG_P95_MS="400"
K6_SLUG_MAX_FAIL_RATE="0.001"

K6_SURVEY_STAGE1_DURATION="20s"
K6_SURVEY_STAGE1_TARGET="1"
K6_SURVEY_STAGE2_DURATION="20s"
K6_SURVEY_STAGE2_TARGET="1"
K6_SURVEY_STAGE3_DURATION="10s"
K6_SURVEY_STAGE3_TARGET="0"
K6_SURVEY_P95_MS="1500"
K6_SURVEY_MAX_FAIL_RATE="0.05"
K6_SURVEY_ITERATION_SLEEP_SECONDS="1"

# Platform tasks benchmark vars
PERF_BASE_URL="https://your-backend-service.onrender.com"
PERF_TOKEN="replace-with-bearer-token"
PERF_ORG_ID="replace-with-client-org-id"
PERF_ENABLE_WRITES="false"
